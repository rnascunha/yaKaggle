{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kaggle Dataset Metadata",
  "description": "Configuration metadata for Kaggle Datasets",
  "type": "object",
  "required": ["title", "id", "licenses"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 6,
      "maxLength": 50,
      "description": "The title of the dataset (between 6 and 50 characters)."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+$",
      "description": "Unique identifier in the format 'username/dataset-slug'."
    },
    "id_no": {
      "type": ["integer", "null"],
      "description": "Kaggle internal numeric ID."
    },
    "subtitle": {
      "type": "string",
      "maxLength": 80,
      "description": "Short subtitle explaining what the dataset contains (up to 80 characters)."
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the dataset in Markdown format."
    },
    "isPrivate": {
      "type": "boolean",
      "default": true,
      "description": "Whether the dataset is private to you and your collaborators."
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "CC0-1.0",
              "CC-BY-4.0",
              "CC-BY-SA-4.0",
              "CC-BY-NC-4.0",
              "CC-BY-NC-SA-4.0",
              "CC-BY-ND-4.0",
              "Apache-2.0",
              "GPL-2.0",
              "GPL-3.0",
              "MIT",
              "ODbL-1.0",
              "other",
              "unknown"
            ],
            "description": "License governing the dataset."
          }
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tags/keywords to improve discoverability."
    },
    "collaborators": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Usernames of Kaggle users who have edit/admin permissions."
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "name": { "type": "string" },
          "totalBytes": { "type": "integer" },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
